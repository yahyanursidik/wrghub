---
import { ClientRouter } from 'astro:transitions';
import { PublicNavigation } from '../components/layout/PublicNavigation';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
}

const { title, description = 'Portal Publik Transparansi & Rekapitulasi Iuran WargaHub', currentPath = Astro.url.pathname } = Astro.props;
---

<!DOCTYPE html>
<html lang="id" class="h-full bg-canvas text-ink antialiased">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <ClientRouter />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#245C4A" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-full flex flex-col bg-canvas text-ink font-sans">
    <a href="#main-content" class="skip-link">Lewati menu, ke konten</a>
    <PublicNavigation currentPath={currentPath} />
    <main id="main-content" tabindex="-1" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 pb-24 lg:pb-8">
      <slot />
    </main>

    <!-- Public Footer -->
    <footer class="bg-surface border-t border-border mt-auto py-6 mb-20 lg:mb-0">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-muted">
        <div class="flex items-center gap-2">
          <span class="font-bold text-ink">WargaHub Smart Residential</span>
          <span>•</span>
          <span>Transparansi Kas & Iuran Terbuka</span>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          <span>Dikembangkan oleh <a href="https://yahyanursidik.my.id/" target="_blank" rel="noopener noreferrer" class="font-bold text-primary-700 hover:text-primary-800 hover:underline">Yahya Nursidik</a></span>
          <span>•</span>
          <span>© 2026 Paguyuban Warga</span>
        </div>
      </div>
    </footer>
  </body>
</html>
