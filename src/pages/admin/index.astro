---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AdminDashboardView } from '../../components/admin/AdminDashboardView';
import { getPropertyStats } from '../../services/property.service';
import { getBillingProgress, getCurrentBillingPeriod } from '../../services/billing.service';
import { getMainAccountBalance } from '../../services/finance.service';
import { getPendingPaymentsCount, getPayments } from '../../services/payment.service';
import { getOpenComplaintsCount } from '../../services/complaint.service';
import { getNeedingRepairCount } from '../../services/facility.service';
import { getProperties } from '../../services/property.service';

const propStats = await getPropertyStats();
const propertiesList = await getProperties();
const currentPeriod = await getCurrentBillingPeriod();
const billingProgress = currentPeriod ? await getBillingProgress(currentPeriod.id) : {
  total: 0,
  paidCount: 0,
  unpaidCount: 0,
  percentage: 0,
  totalAmount: 0,
  paidAmount: 0,
  unpaidAmount: 0,
  monthlyRatePerHouse: 250000,
};

const cashBalance = await getMainAccountBalance();
const pendingPayments = await getPendingPaymentsCount();
const pendingPaymentsList = await getPayments(undefined, 'PENDING');
const openComplaints = await getOpenComplaintsCount();
const needingRepair = await getNeedingRepairCount();

const stats = {
  totalProperties: propStats.total ?? 0,
  occupiedProperties: propStats.occupied ?? 0,
  vacantProperties: propStats.vacant ?? 0,
  occupiedPercentage: propStats.occupiedPercentage ?? '0.0',
  vacantPercentage: propStats.vacantPercentage ?? '0.0',
  paidCount: billingProgress.paidCount ?? 0,
  unpaidCount: billingProgress.unpaidCount ?? 0,
  paidPercentage: billingProgress.percentage ?? 0,
  paidAmount: billingProgress.paidAmount ?? 0,
  unpaidAmount: billingProgress.unpaidAmount ?? 0,
  monthlyRate: 250000,
  cashBalance: cashBalance ?? 0,
  pendingPaymentsCount: pendingPayments ?? 0,
  openComplaintsCount: openComplaints ?? 0,
  needingRepairCount: needingRepair ?? 0,
};

const cookieUser = Astro.cookies.get('wargahub_user');
let currentUser = undefined;
if (cookieUser && cookieUser.value) {
  try {
    currentUser = JSON.parse(cookieUser.value);
  } catch (e) {}
}

const pageTitle = currentUser?.role === 'TREASURER' ? 'Dashboard Bendahara - WargaHub'
  : currentUser?.role === 'SECRETARY' ? 'Dashboard Sekretaris - WargaHub'
  : currentUser?.role === 'SECURITY' ? 'Dashboard Satpam & Keamanan - WargaHub'
  : currentUser?.role === 'MAINTENANCE' ? 'Dashboard Kebersihan & Fasum - WargaHub'
  : 'Dashboard Ketua Komplek - WargaHub';
---

<AdminLayout title={pageTitle} currentPath="/admin">
  <AdminDashboardView 
    stats={stats} 
    currentUser={currentUser} 
    pendingPayments={pendingPaymentsList} 
    properties={propertiesList} 
    client:load 
  />
</AdminLayout>
