---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AdminDashboardView } from '../../components/admin/AdminDashboardView';
import { getWorkspaceNavigation, hasWorkspace } from '../../lib/dashboard-workspace';
import { getDashboardCounts } from '../../services/dashboard.service';
import type { UserSession } from '../../types/auth';

const user = await Astro.session?.get('wargahub_user') as UserSession | undefined;
if (!user || !hasWorkspace(user.role)) return Astro.redirect('/warga');
const workspace = getWorkspaceNavigation(user.role);
const counts = await getDashboardCounts(workspace.items);
---
<AdminLayout title={`${workspace.title} - WargaHub`} currentPath="/admin">
  <AdminDashboardView role={user.role} name={user.fullName} counts={counts} />
</AdminLayout>
