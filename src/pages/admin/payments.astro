---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { PaymentsManager } from '../../components/admin/PaymentsManager';
import { getPayments } from '../../services/payment.service';
import { getAccounts } from '../../services/finance.service';
import { getBillingPeriods } from '../../services/billing.service';
import { getProperties } from '../../services/property.service';
if (Astro.url.searchParams.get('tab') === 'receiving_channels') return Astro.redirect('/admin/ledger?tab=accounts_manage', 302);

const [payments, accounts, properties, periods] = await Promise.all([
  getPayments().catch(() => []),
  getAccounts().catch(() => []),
  getProperties().catch(() => []),
  getBillingPeriods(),
]);
---

<AdminLayout title="Pembayaran & Verifikasi - WargaHub" currentPath="/admin/payments">
  <PaymentsManager initialTab={Astro.url.searchParams.get('tab') || undefined} initialPayments={payments} initialAccounts={accounts} initialProperties={properties} initialPeriods={periods.map(item => String(item.name))} initialHouse={Astro.url.searchParams.get('search') || ''} initialPeriod={Astro.url.searchParams.get('period') || ''} client:load />
</AdminLayout>
