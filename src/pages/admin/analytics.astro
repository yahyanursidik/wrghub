---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { AnalyticsManager } from '../../components/admin/AnalyticsManager';
import { getProperties } from '../../services/property.service';
import { getLedgerEntries } from '../../services/finance.service';
import { getComplaints } from '../../services/complaint.service';
import { getInvoices } from '../../services/billing.service';

const [properties, ledgerEntries, complaints, invoices] = await Promise.all([
  getProperties().catch(() => []),
  getLedgerEntries(200).catch(() => []),
  getComplaints().catch(() => []),
  getInvoices().catch(() => []),
]);
---

<AdminLayout title="Analitik & Tren Finansial - WargaHub" currentPath="/admin/analytics">
  <AnalyticsManager
    properties={properties as any}
    ledgerEntries={ledgerEntries as any}
    complaints={complaints as any}
    invoices={invoices as any}
    client:load
  />
</AdminLayout>
