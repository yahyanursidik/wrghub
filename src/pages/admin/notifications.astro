---
import { ArrowUpRight, Bell } from 'lucide-react';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getDashboardCounts } from '../../services/dashboard.service';
import { getNotificationItems, hasWorkspace, workItems } from '../../lib/dashboard-workspace';
import { canAccessAdminPage } from '../../lib/access-policy';
import type { UserSession } from '../../types/auth';

const user = await Astro.session?.get('wargahub_user') as UserSession | undefined;
if (!user || !hasWorkspace(user.role)) return Astro.redirect('/warga');
const keys = getNotificationItems(user.role);
const counts = await getDashboardCounts(keys);
---
<AdminLayout title="Notifikasi - WargaHub" currentPath="/admin/notifications">
  <div class="workspace">
    <header class="workspace-heading">
      <div><p class="workspace-kicker"><Bell size={16} /> Antrean kerja</p><h1>Notifikasi</h1></div>
    </header>
    <section class="workspace-panel" aria-label="Antrean yang dapat ditindaklanjuti">
      {keys.length ? <ul class="workspace-rows">{keys.map(key => <li>
        <a class="workspace-row" href={workItems[key].href}>
          <span class="workspace-dot" data-tone={workItems[key].tone}></span>
          <span>{workItems[key].label}</span>
          <strong class="workspace-row-value">{counts[key] ?? 'Belum tersedia'}</strong>
          <ArrowUpRight size={16} />
        </a>
      </li>)}</ul> : <p>Tidak ada antrean untuk peran ini.</p>}
    </section>
    {canAccessAdminPage(user.role, '/admin/audit') && <a class="workspace-text-link" href="/admin/audit">Riwayat aktivitas <ArrowUpRight size={16} /></a>}
  </div>
</AdminLayout>
