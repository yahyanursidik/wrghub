---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { BudgetManager } from '../../components/admin/BudgetManager';
import { getProperties } from '../../services/property.service';
import { getCurrentBillingPeriod, getInvoices } from '../../services/billing.service';
import { getExpenses, getMainAccountBalance } from '../../services/finance.service';

const [properties, currentPeriod, expenses, mainBalance] = await Promise.all([
  getProperties().catch(() => []),
  getCurrentBillingPeriod().catch(() => null),
  getExpenses().catch(() => []),
  getMainAccountBalance().catch(() => 0),
]);
const invoices = currentPeriod ? await getInvoices(currentPeriod.id).catch(() => []) : [];
---

<AdminLayout title="Anggaran & Realisasi - WargaHub" currentPath="/admin/budget">
  <BudgetManager
    initialProperties={properties as any}
    initialInvoices={invoices as any}
    initialExpenses={expenses as any}
    initialBalance={mainBalance}
    client:load
  />
</AdminLayout>
