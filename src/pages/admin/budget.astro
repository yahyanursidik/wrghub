---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { BudgetManager } from '../../components/admin/BudgetManager';
import { BUDGET_TABS, reportMonth } from '../../lib/planning-data';
import { jakartaDate } from '../../lib/billing-data';
import { canManageFinance } from '../../lib/access-policy';
import { canApproveBudget, getBudgetWorkspace, listReserveFunds } from '../../services/budget-planning.service';
import { getAccounts } from '../../services/finance.service';
import type { UserSession } from '../../types/auth';

const actor=await Astro.session?.get('wargahub_user') as UserSession|undefined;
if(!actor) return Astro.redirect('/login?portal=admin');
const params=Astro.url.searchParams;
const month=reportMonth(params.get('month'));
const tab=BUDGET_TABS.find(item=>item===params.get('tab')) || 'budget_matrix';
const data=await Promise.all([getBudgetWorkspace(month),tab==='sinking_fund'?listReserveFunds():[],
  tab==='sinking_fund'?getAccounts():[]]).then(([budget,funds,accounts])=>({budget,funds,accounts}))
  .catch(error=>{console.error('Budget workspace could not load',error instanceof Error?error.name:typeof error);return null;});
if(!data) Astro.response.status=503;
---

<AdminLayout title="Anggaran & Realisasi · WargaHub" currentPath="/admin/budget">
  {data ? <BudgetManager {...data} tab={tab} category={params.get('category')?.slice(0,64) || ''}
    fundFocus={params.get('fund')?.slice(0,64) || ''} moved={params.get('moved')?.slice(0,64) || ''}
    canWrite={canManageFinance(actor.role)} canApprove={canApproveBudget(actor.role)} today={jakartaDate()} client:load />
  : <section class="workspace-panel" role="alert"><h1 class="text-xl font-bold">Anggaran</h1>
    <p class="mt-2 text-sm text-ink-muted">Data anggaran belum dapat dimuat.</p>
    <a class="btn-secondary mt-3 inline-flex min-h-11 items-center" href={Astro.url.pathname+Astro.url.search} data-astro-reload>Coba lagi</a>
  </section>}
</AdminLayout>
