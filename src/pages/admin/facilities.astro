---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { FacilitiesManager } from '../../components/admin/FacilitiesManager';
import { getFacilities, getMaintenanceRequests } from '../../services/facility.service';

const facilities = await getFacilities();
const maintenanceRequests = await getMaintenanceRequests();
const tab = Astro.url.searchParams.get('tab') || 'facilities';
---

<AdminLayout title="Sarana & Maintenance - WargaHub" currentPath="/admin/facilities">
  <FacilitiesManager facilities={facilities} maintenanceRequests={maintenanceRequests} initialTab={tab} client:load />
</AdminLayout>
