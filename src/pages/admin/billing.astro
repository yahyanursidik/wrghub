---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { BillingManager } from '../../components/admin/BillingManager';
import { getBillableProperties, getBillingPeriods, getInvoices, selectBillingPeriod } from '../../services/billing.service';
import { getBillingTariff } from '../../services/billing-tariff.service';
import { getProperties } from '../../services/property.service';
import { getAccounts } from '../../services/finance.service';
import { getFinanceWhatsAppProfile } from '../../services/settings.service';
import { canManageFinance } from '../../lib/access-policy';
import { jakartaDate } from '../../lib/billing-data';
import type { UserSession } from '../../types/auth';

const actor = await Astro.session?.get('wargahub_user') as UserSession | undefined;
if (!actor) return Astro.redirect('/login?portal=admin');

const today = jakartaDate();
const canManage = canManageFinance(actor.role);
const requested = Astro.url.searchParams.get('period')?.slice(0,100) || '';
const invoiceId = Astro.url.searchParams.get('invoice')?.slice(0,64) || '';
const data = await Promise.all([
  getBillingPeriods(), getInvoices('ALL',{details:true}), getProperties(), getAccounts(), getBillingTariff(), getBillableProperties(),
  canManage ? getFinanceWhatsAppProfile().catch(()=>null) : null,
]).then(([periods,invoices,properties,accounts,tariff,billable,shareProfile]) => ({
  periods,invoices,accounts,tariff,billableIds:billable.map(item=>item.id),shareProfile,
  houses:properties.map(item=>({id:item.id,code:item.code,name:item.occupantName || item.ownerName,block:item.blockName,occupancy:item.occupancyStatus})),
})).catch(()=>null);
if (!data) Astro.response.status = 503;

const invoicePeriod = data?.invoices.find(item=>item.id===invoiceId)?.billingPeriodId;
const current = data ? selectBillingPeriod(data.periods,invoicePeriod || requested,today) : undefined;
const unknownPeriod = Boolean(requested && !invoicePeriod && !data?.periods.some(item=>item.id===requested || item.name===requested));
---

<AdminLayout title="Tagihan iuran · WargaHub" currentPath="/admin/billing">
  {data ? <BillingManager
    {...data}
    today={today}
    canManage={canManage}
    initialTab={Astro.url.searchParams.get('tab') || undefined}
    initialHouse={Astro.url.searchParams.get('house')?.slice(0,64) || ''}
    initialBlock={Astro.url.searchParams.get('block')?.slice(0,100) || ''}
    initialPeriodId={current?.id || ''}
    initialInvoiceId={invoiceId}
    unknownPeriod={unknownPeriod}
    client:load
  /> : <section class="workspace-panel" role="alert">
    <h1 class="text-2xl font-bold">Tagihan iuran</h1>
    <p class="mt-2 text-ink-muted">Data tagihan belum bisa dimuat.</p>
    <a class="btn-secondary mt-3 inline-flex min-h-11 items-center" href={Astro.url.pathname + Astro.url.search} data-astro-reload>Coba lagi</a>
  </section>}
</AdminLayout>
