---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { ExpensesManager } from '../../components/admin/ExpensesManager';
import { 
  getExpenses, 
  getAccounts, 
  getMainAccountBalance,
  getRecurringExpensesConfig 
} from '../../services/finance.service';

const [expenses, accounts, mainBalance, recurringConfig] = await Promise.all([
  getExpenses().catch(() => []),
  getAccounts().catch(() => []),
  getMainAccountBalance().catch(() => 0),
  getRecurringExpensesConfig().catch(() => []),
]);
---

<AdminLayout title="Pengeluaran & Kas - WargaHub" currentPath="/admin/expenses">
  <ExpensesManager 
    initialExpenses={expenses} 
    initialAccounts={accounts}
    initialBalance={mainBalance}
    initialRecurringConfig={recurringConfig}
    client:load 
  />
</AdminLayout>
