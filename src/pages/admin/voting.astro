---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { VotingManager } from '../../components/admin/VotingManager';
import { getProperties } from '../../services/property.service';

const tab = Astro.url.searchParams.get('tab') || 'election';
const properties = await getProperties().catch(() => []);
---

<AdminLayout title="E-Voting & Musyawarah Warga - WargaHub" currentPath="/admin/voting">
  <VotingManager initialTab={tab} initialProperties={properties} client:load />
</AdminLayout>

