---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { VotingManager } from '../../components/admin/VotingManager';
import { getVotingDashboard } from '../../services/voting.service';

const tab = Astro.url.searchParams.get('tab') || 'election';
const votingData = await getVotingDashboard().catch(() => null);
---

<AdminLayout title="E-Voting & Musyawarah Warga - WargaHub" currentPath="/admin/voting">
  <VotingManager initialTab={tab} initialData={votingData} client:load />
</AdminLayout>
