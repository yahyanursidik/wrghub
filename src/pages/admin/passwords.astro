---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { UserPasswordSettingsTab } from '../../components/admin/UserPasswordSettingsTab';
import { getProperties } from '../../services/property.service';
import type { UserSession } from '../../types/auth';
const actor=await Astro.session?.get('wargahub_user') as UserSession|undefined;
if(!actor) return Astro.redirect('/login?portal=admin');
const houses=(await getProperties().catch(()=>[])).map(({id,code})=>({id,code}));
const house=Astro.url.searchParams.get('house') || '';
---
<AdminLayout title="Akun warga · WargaHub" currentPath="/admin/passwords">
  <div class="space-y-4">
    <h1 class="text-2xl font-bold tracking-tight text-ink">Akun warga</h1>
    <UserPasswordSettingsTab actor={{id:actor.id,role:actor.role}} initialHouse={house} houses={houses} client:load />
  </div>
</AdminLayout>
