---
import { ResidentPortalView } from '../components/portal/ResidentPortalView';
import { InformationDashboard } from '../components/portal/InformationDashboard';
import { PublicNavigation } from '../components/layout/PublicNavigation';
import { filterAnnouncementsForUser, getAnnouncements } from '../services/announcement.service';
import { getResidentOverview } from '../services/resident-overview.service';
import { hasWorkspace } from '../lib/dashboard-workspace';
import type { UserSession } from '../types/auth';
import '../styles/global.css';

const currentUser = await Astro.session?.get('wargahub_user') as UserSession | undefined;
if (!currentUser) return Astro.redirect('/login?portal=resident');
const infoOnly = currentUser.role === 'VIEWER' || (hasWorkspace(currentUser.role) && !currentUser.propertyId && !currentUser.propertyCode);
const [allAnnouncements, overview] = await Promise.all([
  getAnnouncements().catch(() => null),
  infoOnly ? undefined : getResidentOverview(currentUser).catch(() => undefined),
]);
const announcements = allAnnouncements ? filterAnnouncementsForUser(allAnnouncements, currentUser, overview?.property ?? null) : null;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{infoOnly ? 'Informasi Lingkungan - WargaHub' : 'Portal Warga - WargaHub'}</title>
    <meta name="description" content="Cek iuran, informasi lingkungan, data rumah, dan layanan warga Grand Sariwangi." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#059669" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </head>
  <body class="bg-canvas text-ink font-sans min-h-screen antialiased selection:bg-primary-100 selection:text-primary-900">
    {infoOnly ? <>
      <a href="#main-content" class="skip-link">Lewati menu, ke konten</a>
      <PublicNavigation currentPath="/warga" signedIn />
      <main id="main-content" tabindex="-1" class="mx-auto w-full max-w-4xl p-4 pb-24 sm:p-8">
        <InformationDashboard name={currentUser.fullName} role={currentUser.role} news={announcements} client:load />
      </main>
    </> : <ResidentPortalView initialUser={currentUser} initialAnnouncements={announcements ?? []} announcementUnavailable={announcements === null} initialOverview={overview} initialSearch={Astro.url.search} client:load />}
  </body>
</html>
