---
import PublicLayout from '../layouts/PublicLayout.astro';
import { PublicDuesLedger } from '../components/public/PublicDuesLedger';
import { getProperties } from '../services/property.service';
import { getInvoices, getCurrentBillingPeriod, getBillingPeriods, getAllInvoices } from '../services/billing.service';

const periodParam = Astro.url.searchParams.get('period');
const allPeriods = await getBillingPeriods();

const currentPeriod = await getCurrentBillingPeriod().catch(() => null);

// Prioritaskan parameter URL, atau periode berjalan terkini (September 2026), atau periode pertama
const targetPeriod = periodParam 
  ? allPeriods.find((p: any) => p.id === periodParam || p.name === periodParam)
  : (currentPeriod || allPeriods.find((p: any) => p.id === 'period-2026-09') || allPeriods[0]);

const properties = await getProperties().catch(() => []);
const invoices = targetPeriod ? await getInvoices(targetPeriod.id).catch(() => []) : [];
const allInvoices = await getAllInvoices().catch(() => []);
---

<PublicLayout title={`Rekapitulasi Iuran Warga (${targetPeriod?.name || 'September 2026'}) - WargaHub`} currentPath="/rekap-iuran">
  <PublicDuesLedger 
    initialProperties={properties} 
    initialInvoices={invoices} 
    initialPeriodName={targetPeriod?.name || 'September 2026'}
    allInvoices={allInvoices}
    allPeriods={allPeriods}
    client:load 
  />
</PublicLayout>
