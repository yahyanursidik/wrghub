---
import PublicLayout from '../layouts/PublicLayout.astro';
import { PublicDuesLedger } from '../components/public/PublicDuesLedger';
import { getProperties } from '../services/property.service';
import { getInvoices, getCurrentBillingPeriod, getBillingPeriods, getAllInvoices } from '../services/billing.service';
import { neonSql } from '../db/neon';

const periodParam = Astro.url.searchParams.get('period');

// Parallelize all independent master queries
const [allPeriods, currentPeriod, properties, allInvoices, bankRows] = await Promise.all([
  getBillingPeriods().catch(() => []),
  getCurrentBillingPeriod().catch(() => null),
  getProperties().catch(() => []),
  getAllInvoices().catch(() => []),
  process.env.DATABASE_URL
    ? neonSql`SELECT value FROM settings WHERE key = 'community_profile' LIMIT 1`.catch(() => [])
    : Promise.resolve([])
]);

// Prioritaskan parameter URL, atau periode berjalan terkini (September 2026), atau periode pertama
const targetPeriod = periodParam 
  ? allPeriods.find((p: any) => p.id === periodParam || p.name === periodParam)
  : (currentPeriod || allPeriods.find((p: any) => p.id === 'period-2026-09') || allPeriods[0]);

const invoices = targetPeriod ? await getInvoices(targetPeriod.id).catch(() => []) : [];

// Baca rekening resmi paguyuban dari database settings (sinkron dengan admin)
let initialBankInfo = null;
if (bankRows && bankRows.length > 0) {
  try {
    const parsed = typeof bankRows[0].value === 'string' ? JSON.parse(bankRows[0].value) : bankRows[0].value;
    if (parsed && parsed.bankAccount) {
      initialBankInfo = {
        bankName: parsed.bankName || 'Jago Syariah',
        accountNumber: parsed.bankAccount,
        accountHolder: parsed.accountHolder || 'Yahya Nursidik',
        qrisNmid: 'ID102008891230',
      };
    }
  } catch (e) {
    console.warn('Gagal membaca rekening dari database settings:', e);
  }
}
---

<PublicLayout title={`Rekapitulasi Iuran Warga (${targetPeriod?.name || 'September 2026'}) - WargaHub`} currentPath="/rekap-iuran">
  <PublicDuesLedger 
    initialProperties={properties} 
    initialInvoices={invoices} 
    initialPeriodName={targetPeriod?.name || 'September 2026'}
    allInvoices={allInvoices}
    allPeriods={allPeriods}
    initialBankInfo={initialBankInfo}
    client:load 
  />
</PublicLayout>
