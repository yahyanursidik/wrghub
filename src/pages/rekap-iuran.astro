---
import { financeMonthPattern } from '../lib/cash-data';
import { publicReportPath, publicReportPeriod } from '../lib/transparency-data';
import { getBillingPeriods } from '../services/billing.service';

const value=Astro.url.searchParams.get('period')?.slice(0,100) || '';
const selected=value && !financeMonthPattern.test(value) ?
  (await getBillingPeriods().catch(()=>[])).find(item=>item.id===value || item.name===value) : undefined;
const period=selected?publicReportPeriod(String(selected.year),String(selected.month)):publicReportPeriod(null,null,value);
return Astro.redirect(publicReportPath(period,'dues_breakdown'),302);
---
