---
import PublicLayout from '../../layouts/PublicLayout.astro';
import { TransparencyView } from '../../components/transparency/TransparencyView';
import { publicJournalParams, publicReportFilters, publicReportPath, publicReportPeriod } from '../../lib/transparency-data';
import { getPublicMonthlyReport } from '../../services/transparency.service';

const query = Astro.url.searchParams;
const filters = publicReportFilters(query);
const period = publicReportPeriod(query.get('year'),query.get('month'),query.get('period'));
if (filters.tab==='public_ledger' && query.get('download')==='csv')
  return Astro.redirect(publicReportPath(period,filters.tab,{...publicJournalParams(filters),download:'csv'}),302);
Astro.response.headers.set('Cache-Control','no-store');
const data = await getPublicMonthlyReport(period,filters,Astro.url.origin).catch(()=>null);
if (!data) Astro.response.status=503;
---

<PublicLayout title={data ? 'Laporan Transparansi Warga - '+data.periodLabel+' - WargaHub' : 'Laporan Transparansi Warga - WargaHub'} currentPath={filters.tab==='dues_breakdown'?'/rekap-iuran':'/transparency'}>
  {data ? <TransparencyView data={data} filters={filters} client:load /> :
    <section class="mx-auto max-w-5xl p-5" role="alert"><h1 class="text-2xl font-bold">Laporan warga</h1>
      <p class="mt-2 text-sm text-ink-muted">Data laporan belum bisa dimuat.</p>
      <a class="btn-secondary mt-3 inline-flex min-h-11 items-center" href={Astro.url.pathname+Astro.url.search} data-astro-reload>Coba lagi</a>
    </section>}
</PublicLayout>
