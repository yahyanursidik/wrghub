---
import PublicLayout from '../../../layouts/PublicLayout.astro';
import { TransparencyView } from '../../../components/transparency/TransparencyView';
import { getPublicMonthlyReport } from '../../../services/transparency.service';

const { year, month } = Astro.params;
const reportData = await getPublicMonthlyReport(parseInt(year || '2026', 10), parseInt(month || '9', 10));
---

<PublicLayout title={`Laporan Transparansi Warga - ${reportData.periodName}`} currentPath="/transparency">
  <TransparencyView initialData={reportData} client:load />
</PublicLayout>

